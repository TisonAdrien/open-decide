# Copy to .env and adjust. Never commit .env.

# Optional: Hugging Face token (raises rate limits, faster downloads).
# Create a Read-only token at https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional: preload a backend at startup instead of on first request.
# Values: tamev, openjev, cascade, mock (or empty to disable).
OPEN_DECIDE_PRELOAD_BACKEND=

# Optional: server-side max upload size (bytes). Enforced by the app.
# OPEN_DECIDE_MAX_UPLOAD_BYTES=5242880
